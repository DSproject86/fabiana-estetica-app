ADMIN_PASSWORD_1=""
ADMIN_NAME_1="Fabiana"     # facoltativo
ADMIN_EMAIL_2=""
ADMIN_PASSWORD_2=""
ADMIN_NAME_2=""            # facoltativo

# Email (Resend). Senza dominio verificato Resend consegna solo all'email del proprietario dell'account.
# In sviluppo, se mancano, il codice di accesso compare nel terminale.
RESEND_API_KEY=""
EMAIL_FROM="Fabiana L. · Estetica <onboarding@resend.dev>"

