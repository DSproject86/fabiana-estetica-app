# Database Neon (Prisma)
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"   # connessione pooled (app)
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"     # connessione diretta (migrazioni)

# Sessioni: stringa casuale lunga almeno 32 caratteri (es. `openssl rand -base64 48`)
SESSION_SECRET=""

# Admin (usate solo dallo script di seed)
ADMIN_EMAIL_1=""
ADMIN_PASSWORD_1=""
ADMIN_NAME_1="Fabiana"     # facoltativo
ADMIN_EMAIL_2=""
ADMIN_PASSWORD_2=""
ADMIN_NAME_2=""            # facoltativo

# Email (Resend), mittente su dominio verificato.
# In sviluppo, se mancano, nessuna email parte e il codice di accesso compare nel terminale.
RESEND_API_KEY=""
EMAIL_FROM="Fabiana L. Estetica <prenotazioni@example.it>"
EMAIL_REPLY_TO=""          # facoltativo: indirizzo a cui arrivano le risposte delle clienti

# Indirizzo pubblico dell'app: link nelle email e link d'invito (es. https://prenota.example.it).
# Se vuoto: per l'invito si usa il dominio da cui si sta navigando, nelle email http://localhost:3000.
APP_URL=""

# Segreto per /api/cron/promemoria (header "Authorization: Bearer <CRON_SECRET>").
# Stringa casuale lunga (es. `openssl rand -hex 32`). Se vuoto l'endpoint risponde sempre 401.
CRON_SECRET=""
